# Every integration falls back to a labelled demo mode when its keys are missing.

# Postgres (Neon or Supabase). Without it the app uses an in-memory store.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Gemini Flash: transcript → structured facts
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Vaani Labs webhook signing secret (vv_whk_...), shown once when the webhook is created
VAANI_WEBHOOK_SECRET=

# Telegram: bot from @BotFather, added to the designers' group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ESCALATION_CHAT_ID=   # optional, defaults to TELEGRAM_CHAT_ID
TELEGRAM_FRONTDESK_CHAT_ID=    # optional, call-backs; defaults to TELEGRAM_CHAT_ID
TELEGRAM_WEBHOOK_SECRET=       # any random string; set the same on setWebhook

# Cal.com API v2
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
CAL_ATTENDEE_EMAIL=            # studio inbox that receives booking confirmations

# HubSpot private app token (scopes: crm.objects.contacts.write/read, crm.objects.deals.write)
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=             # account number, for deal links

# Dashboard sign-in (OPEN_ACCESS=true turns it off: anyone with the link can use the dashboard)
OPEN_ACCESS=
ACCESS_CODE=
SESSION_SECRET=
APP_URL=                       # e.g. https://aangan-call-desk.vercel.app

# Unit costs and business assumptions (INR); defaults shown
VAANI_INR_PER_MIN=5.6
GEMINI_USD_PER_M_INPUT=0.3
GEMINI_USD_PER_M_OUTPUT=2.5
USD_INR=88
AVG_PROJECT_VALUE_INR=1100000
CONSULT_TO_PROJECT_RATE=0.25
ENQUIRIES_PER_MONTH=200
